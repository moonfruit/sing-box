#!/usr/bin/env bash
# Pi 的测试替身。PI_STUB_MODE 决定它如何「解决」冲突。
set -euo pipefail
prompt=$(cat)
[[ "$*" == '--print --no-session --no-approve --model openai/gpt-6.2-sol --thinking medium' ]]
case "${PI_STUB_MODE:-resolve}" in
  consecutive|fail-second)
    file=$(git diff --name-only --diff-filter=U)
    [[ "$prompt" == *"$(git log -1 --format=%s REBASE_HEAD)"* ]]
    case "$file" in
      app.go)   printf 'line1\nresolved\n' > app.go ;;
      other.go)
        [[ "$PI_STUB_MODE" != fail-second ]] || exit 1
        printf 'resolved other\n' > other.go ;;
      *) exit 1 ;;
    esac
    printf '已解决 %s\n' "$file" ;;
  resolve)   printf 'line1\nresolved\n' > app.go; printf '已合并两侧改动\n' ;;
  resolve-with-draft)
    # 除了正常解决冲突，顺手留一份未跟踪的草稿文件——模拟模型探索过程中
    # 落下的东西，git add -A 会把它一并收拢进 patch 提交。
    printf 'line1\nresolved\n' > app.go
    printf 'debug notes\n' > scratch-notes.md
    printf '已合并两侧改动（顺手留了份笔记）\n'
    ;;
  leave)     printf '我放弃了\n' ;;   # 不动文件，冲突标记留在原地
  leave-corrupt)
    # 模拟本地调用模型时跑了一次不带参数的 git reset
    # （哪怕只是想撤销自己刚刚的暂存）：mixed reset 在冲突现场是被允许的，
    # 不动工作区（冲突标记原样留在文件里，闸门①依然会拦下），但会把 ORIG_HEAD
    # 悄悄重写成执行时的 HEAD——此刻 mid-rebase，HEAD 站在新基点上，不是我们
    # 想回退到的提交。（git reset --hard 反而不适合用来复现这个场景：它会把
    # 工作区一并清空，冲突标记随之消失，成了「碰巧解决了」而不是「留下一个
    # 需要正确回退目标的失败」。）
    git reset >/dev/null
    printf '我放弃了，但是先跑了一次 git reset\n'
    ;;
  fail)      exit 1 ;;
esac
