#!/usr/bin/env bash
# gh 的测试替身。
set -euo pipefail
case "${1:-}" in
  api)
    case "$2" in
      # 夹具里混入一个 -reF1nd-moonfruit：它不以 -reF1nd[.N] 结尾，
      # 必须被过滤掉，否则我们自己的发布 tag 会被当成上游基点。
      # 真跑调用方传来的 --jq 过滤条件（而不是自己重新实现一遍），
      # 这样测试才会真的驱动 detect.sh 里的正则，而不是摆设。
      repos/reF1nd/sing-box/tags*)
        shift 2
        filter=
        while [[ $# -gt 0 ]]; do
          if [[ "$1" == --jq ]]; then filter=${2:?"stub: --jq 缺少参数"}; break; fi
          shift
        done
        [[ -n "$filter" ]] || filter='.[].name'
        jq -r "$filter" <<'JSON'
[
  {"name": "v1.14.0-alpha.43-reF1nd"},
  {"name": "v1.14.0-beta.5-reF1nd"},
  {"name": "v1.14.0-beta.5-reF1nd.1"},
  {"name": "v1.14.0-beta.9-reF1nd-moonfruit"}
]
JSON
        ;;
      *) exit 1 ;;
    esac ;;
  issue)
    printf 'GH %s\n' "$*" >> "${GH_STUB_LOG:?}"
    if [[ "${2:-}" == list && "${GH_STUB_MODE:-}" == issue-exists ]]; then
      printf '7\n'
    fi
    ;;
  pr)
    printf 'GH %s\n' "$*" >> "${GH_STUB_LOG:?}"
    case "${2:-}" in
      list)   printf '42\n' ;;
      # tap 的 test-bot 结果；GH_STUB_CHECKS 可改成 fail 以验证判别力。
      # 与 api 分支同理：真跑调用方的 --jq，否则被测的过滤条件形同虚设。
      checks)
        filter=
        args=("$@")
        for ((i = 0; i < ${#args[@]}; i++)); do
          if [[ "${args[i]}" == --jq ]]; then filter=${args[i+1]:?"stub: --jq 缺少参数"}; break; fi
        done
        [[ -n "$filter" ]] || filter='.'
        jq -r "$filter" <<JSON
[{"name":"test-bot (macos-26)","bucket":"${GH_STUB_CHECKS:-pass}"}]
JSON
        ;;
    esac
    ;;
  *) exit 1 ;;
esac
